---
import Layout from "@/layouts/Layout.astro";
import logo from "@/assets/logo-white-transparent.png";
---

<Layout meta={{ title: "Links" }}>
  <div class="w-full flex justify-end">
    <img src={logo.src} alt="Logo" width="24" class="mx-4 mt-4" />
  </div>
  <main class="flex flex-col justify-center items-center h-full">
    <section class="flex flex-col justify-center items-center">
      <ul class="flex flex-col gap-10">
        <li>
          <a
            href="https://alvgaona.com"
            class="underline underline-offset-4 decoration-vesper-gold"
          >
            Website
          </a>
        </li>
        <li>
          <a
            href="https://x.com/alvgaona"
            class="underline underline-offset-4 decoration-vesper-gold"
          >
            X
          </a>
        </li>
        <li>
          <a
            href="https://instagram.com/alvgaona"
            class="underline underline-offset-4 decoration-vesper-gold"
          >
            Instagram
          </a>
        </li>
        <li>
          <a
            href="https://linkedin.com/in/alvaro-gaona"
            class="underline underline-offset-4 decoration-vesper-gold"
          >
            LinkedIn
          </a>
        </li>
        <li>
          <a
            href="https://scholar.google.com/citations?user=unBAfxAAAAAJ"
            class="underline underline-offset-4 decoration-vesper-gold"
          >
            Google Scholar
          </a>
        </li>
        <li class="ripple">
          <a
            href="https://github.com/alvgaona"
            class="underline underline-offset-4 decoration-vesper-gold"
          >
            Github
          </a>
        </li>
      </ul>
    </section>
  </main>
</Layout>
